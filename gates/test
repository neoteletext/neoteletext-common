#!/usr/bin/env bash
# The machinery's own test, on throwaway repositories: what the gate must
# refuse it refuses, and what it must let through it does. GATE_UNDER_TEST
# names another copy of gate.sh, to see a test fail on an older one.
set -euo pipefail
# A hook in a linked worktree inherits GIT_DIR and its neighbours, which
# override -C: every throwaway repository below would then be the real one,
# and git init and git config would rewrite its configuration.
# shellcheck disable=SC2046 # one name a word
unset $(git rev-parse --local-env-vars)
gates="$(cd "$(dirname "$0")" && pwd)"
gate="${GATE_UNDER_TEST:-$gates/gate.sh}"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
failures=0

# The names are written in two parts, so that this file does not name them.
deleted() { printf '%s.md' "$1"; }

# Runs check_deleted_documents in a repository holding $2 at path $1, with
# any further arguments as DELETED_DOCUMENT_HISTORY. Says whether it passed.
guard() {
    local path="$1" text="$2"
    shift 2
    local repository="$work/guard-$RANDOM$RANDOM"
    mkdir -p "$repository/$(dirname "$path")"
    git -C "$repository" init -q
    printf '%s\n' "$text" >"$repository/$path"
    git -C "$repository" add -- "$path"
    (
        cd "$repository"
        DELETED_DOCUMENT_HISTORY=("$@")
        # shellcheck source=/dev/null
        . "$gate"
        check_deleted_documents
    ) >/dev/null 2>&1
}

expect() {
    local want="$1" name="$2"
    shift 2
    local got=passes
    "$@" || got=refused
    if [[ "$got" == "$want" ]]; then
        printf 'ok: %s %s\n' "$name" "$want"
    else
        printf 'FAILED: %s: wanted %s, got %s\n' "$name" "$want" "$got" >&2
        failures=$((failures + 1))
    fi
}

for stem in INPUT SERVER CHANNEL; do
    expect refused "a comment naming $stem" guard src/a.rs "// see $(deleted "$stem") section 5.4"
done
expect refused "a name at a line's start" guard docs/a.md "$(deleted INPUT) is the protocol"
expect refused "a name in a path" guard docs/a.md "see neoteletext-common/$(deleted SERVER)"
expect refused "a name with its dot escaped" guard test/a.ts "/${stem:-CHANNEL}\\.md section 7/"
expect refused "another file's mention, with one file allowed" guard docs/a.md "$(deleted INPUT)" docs/other.md
expect passes "a file named as history" guard reviews/old.md "$(deleted INPUT) v2" reviews/old.md
expect passes "the document that stays" guard docs/a.md "see RETURN-$(deleted CHANNEL) section 2"
expect passes "another document ending in a name" guard docs/a.md "see MY_$(deleted INPUT)"
expect passes "a lower-case file" guard docs/a.md "see docs/spec/design/input.md"
expect passes "a file with no mention" guard src/a.rs "// DOC-1931"

# A document alone is staged, which CHECKED_PATHS does not hold: the commit
# gate still reads it, and a clean one still commits.
commit_a_document() {
    local repository="$work/commit-$RANDOM$RANDOM"
    mkdir -p "$repository/scripts" "$repository/docs"
    git -C "$repository" init -q
    cp "$gate" "$repository/scripts/gate.sh"
    cat >"$repository/scripts/check.sh" <<'CHECK'
#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
readonly CHECKED_PATHS=(src)
. scripts/gate.sh
commit_steps() { :; }
gate_main "$@"
CHECK
    chmod +x "$repository/scripts/check.sh"
    printf '%s\n' "$1" >"$repository/docs/a.md"
    git -C "$repository" add docs/a.md
    NEOTELETEXT_COMMON="$repository" "$repository/scripts/check.sh" commit >/dev/null 2>&1
}
expect refused "a document naming one, alone in a commit" commit_a_document "$(deleted SERVER)"
expect passes "a clean document, alone in a commit" commit_a_document "DOC-1931"

# TODO-1771: from a hook in a linked worktree, whose GIT_DIR git exports, the
# copy of the gate is still compared with neoteletext-common's, truly: an
# edited copy is refused, given a first argument to append to the copy.
copy_from_a_worktree() {
    local edit="${1:-}"
    local common="$work/common-$RANDOM$RANDOM" repository
    repository="$common-repository"
    mkdir -p "$common/gates"
    git -C "$common" init -q
    git -C "$common" config user.email test@example.invalid
    git -C "$common" config user.name test
    cp "$gate" "$common/gates/gate.sh"
    printf 'hook\n' | tee "$common/gates/pre-commit" "$common/gates/pre-merge-commit" "$common/gates/pre-push" >/dev/null
    git -C "$common" add gates
    git -C "$common" commit -qm first
    mkdir -p "$repository/scripts" "$repository/.githooks"
    git -C "$repository" init -q
    {
        printf '# Copied\n# neoteletext-common gates at %s\n' "$(git -C "$common" rev-parse HEAD)"
        cat "$gate"
        printf '%s' "$edit"
    } >"$repository/scripts/gate.sh"
    cp "$common"/gates/pre-* "$repository/.githooks/"
    (
        cd "$repository"
        export NEOTELETEXT_COMMON="$common" GIT_DIR="$repository/.git"
        # shellcheck source=/dev/null
        . scripts/gate.sh
        check_gate_copy
    ) >/dev/null 2>&1
}
expect passes "the gate's copy read with GIT_DIR exported" copy_from_a_worktree
expect refused "an edited copy read with GIT_DIR exported" copy_from_a_worktree "# edited"

# gates.md: a step that cannot run fails the gate, says which tool it lacks
# and how to install it, and records no pass. The check script runs a gate
# whose step needs tool $1; a second argument is what it says to install it.
readonly NO_SUCH_TOOL=neoteletext-test-no-such-tool
readonly INSTALL_ADVICE="run scripts/tools.sh to install it"
tool_gate() {
    local tool="$1" repository="$work/tool-$RANDOM$RANDOM"
    # An empty gates/gate.sh makes it the original, whose copy is not checked:
    # this test holds the tool's rule.
    mkdir -p "$repository/scripts" "$repository/src" "$repository/gates"
    git -C "$repository" init -q
    git -C "$repository" config user.email test@example.invalid
    git -C "$repository" config user.name test
    cp "$gate" "$repository/scripts/gate.sh"
    : >"$repository/gates/gate.sh"
    cat >"$repository/scripts/check.sh" <<CHECK
#!/usr/bin/env bash
set -euo pipefail
cd "\$(dirname "\$0")/.."
readonly CHECKED_PATHS=(src)
. scripts/gate.sh
commit_steps() { :; }
full_steps() {
    step "a step that needs a tool"
    need_tool $tool "$INSTALL_ADVICE"
}
gate_main "\$@"
CHECK
    chmod +x "$repository/scripts/check.sh"
    printf 'code\n' >"$repository/src/a"
    git -C "$repository" add .
    git -C "$repository" commit -qm first
    "$repository/scripts/check.sh" full >"$work/tool-output" 2>&1 || return 1
    [[ -f "$repository/.git/gate-passed-full" ]]
}
says_what_is_missing() {
    grep -qF "$NO_SUCH_TOOL is not installed" "$work/tool-output" && grep -qF "$INSTALL_ADVICE" "$work/tool-output"
}
expect passes "a gate whose step has its tool" tool_gate git
expect refused "a gate whose step lacks its tool" tool_gate "$NO_SUCH_TOOL"
expect passes "the refusal names the tool and how to install it" says_what_is_missing

# Nothing is skipped silently: a check script that can say a step was skipped
# is refused, at the commit that brings it. Written in two parts, as above.
check_script_commit() {
    local repository="$work/skip-$RANDOM$RANDOM"
    mkdir -p "$repository/scripts" "$repository/gates"
    git -C "$repository" init -q
    cp "$gate" "$repository/scripts/gate.sh"
    : >"$repository/gates/gate.sh"
    cat >"$repository/scripts/check.sh" <<CHECK
#!/usr/bin/env bash
set -euo pipefail
cd "\$(dirname "\$0")/.."
readonly CHECKED_PATHS=(scripts)
. scripts/gate.sh
commit_steps() { step "$1"; }
gate_main "\$@"
CHECK
    chmod +x "$repository/scripts/check.sh"
    git -C "$repository" add scripts
    "$repository/scripts/check.sh" commit >/dev/null 2>&1
}
expect refused "a check script reporting a step skipped" check_script_commit "cargo-deny not installed: $(printf 'SKIP%s' PED)"
expect passes "a check script that reports none" check_script_commit "cargo-deny"

[[ "$failures" -eq 0 ]] || {
    printf '%d failed\n' "$failures" >&2
    exit 1
}
printf 'the machinery passes its own test\n'
