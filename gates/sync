#!/usr/bin/env bash
# Writes the gate machinery at neoteletext-common's HEAD into every
# repository gates/repositories names (or those given): scripts/gate.sh,
# naming the commit on its second line, and the hooks. Commit here first:
# the copy names a commit, and each repository's commit gate checks the
# copy against it.
set -euo pipefail
gates="$(cd "$(dirname "$0")" && pwd)"
common="$(dirname "$gates")"
[[ -z "$(git -C "$common" status --porcelain -- gates)" ]] || {
    echo "gates/ has changes that are not committed; commit them first" >&2
    exit 1
}
revision="$(git -C "$common" rev-parse HEAD)"
repositories=("$@")
if [[ ${#repositories[@]} -eq 0 ]]; then
    while IFS= read -r line; do
        [[ -z "$line" || "$line" == \#* ]] || repositories+=("$line")
    done <"$gates/repositories"
fi
for repository in "${repositories[@]}"; do
    target="$common/../$repository"
    [[ -d "$target/scripts" && -d "$target/.githooks" ]] || {
        echo "$repository: no scripts/ and .githooks/ beside neoteletext-common" >&2
        exit 1
    }
    {
        printf '# Copied by neoteletext-common gates/sync; change it there, not here.\n'
        printf '# neoteletext-common gates at %s\n' "$revision"
        git -C "$common" show "$revision:gates/gate.sh"
    } >"$target/scripts/gate.sh"
    for hook in pre-commit pre-merge-commit pre-push; do
        git -C "$common" show "$revision:gates/$hook" >"$target/.githooks/$hook"
        chmod +x "$target/.githooks/$hook"
    done
    echo "$repository: gates at ${revision:0:7}"
done
